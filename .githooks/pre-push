#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Fails a push in seconds for what CI would fail in minutes: formatting always, clippy when the
# pushed commits touch Rust. Enable once per clone: git config core.hooksPath .githooks
# Skip once: git push --no-verify
set -e

zero=0000000000000000000000000000000000000000
rust=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # a branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        # A new branch: compare with where it left main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    else
        base=$remote_sha
    fi
    if [ -z "$base" ] || git diff --name-only "$base" "$local_sha" |
        grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|^rust-toolchain'; then
        rust=1
    fi
done

echo "pre-push: cargo fmt --all --check"
cargo fmt --all --check || {
    echo "pre-push: run 'cargo fmt --all', commit, and push again (or push --no-verify)" >&2
    exit 1
}
if [ "$rust" = 1 ]; then
    echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
    cargo clippy --quiet --workspace --all-targets -- -D warnings
fi

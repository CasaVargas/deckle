{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deckle",
  "version": "0.3.1",
  "identifier": "com.casavargas.deckle",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Deckle",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CasaVargas LLC",
    "copyright": "© 2026 CasaVargas LLC · GPL-3.0-or-later",
    "category": "Productivity",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/CasaVargas/deckle",
    "shortDescription": "Turn EPUBs into store-quality Kindle books",
    "longDescription": "Deckle turns EPUBs you own into Kindle books with Enhanced Typesetting, covers that show, page numbers, X-Ray and Word Wise, and puts them on your Kindle over USB or MTP.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFREUyRDA1NEJFRUQ1OTcKUldTWDFlNUxCUzNlcnB0dTlGcDZteXFlTlRoblNpVFh5clFQaTJ2ZFlFRC9RVmtoZHZGRnhkdUUK",
      "endpoints": [
        "https://github.com/CasaVargas/deckle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
